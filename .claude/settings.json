{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git describe:*)",
      "Bash(git checkout:*)",
      "Bash(git remote:*)",
      "Bash(gh issue:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(node --check:*)",
      "Bash(python -c:*)",
      "Bash(python -m pip install -e .:*)"
