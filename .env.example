# PersonaCore — Compose environment.
#
# Copy this file to `.env` beside compose.yaml and edit the two paths. Compose
# reads `.env` automatically; it is never read by the application itself.
#
# NO SECRETS GO IN THIS FILE. API keys, the LLM's key, the MQTT password — all
# of those are named here by reference only and live in <appdata>/secrets/,
# one file per secret. Nothing in this file is a credential.

# --- Required: where state lives -------------------------------------------
#
# Appdata is the assistant. Personas, plugins, settings, secrets, the audit
# database — all of it. Back this up; an upgrade never touches it.
#
# There is no sensible default, and leaving it unset produces a broken volume
# line rather than an error, so set it explicitly. Absolute path.
PERSONACORE_APPDATA_DIR=/srv/personacore/appdata

# The MQTT broker's config and data. Separate from appdata because the broker
# is disposable and appdata is not.
PERSONACORE_MOSQUITTO_DIR=/srv/personacore/mosquitto

# --- Optional: everything below has a working default ----------------------

# Timezone, used for log timestamps in both containers.
TZ=Etc/UTC

# What the core binds inside the container. There is rarely a reason to change
# these. The port is 8053, not 8080 — the reverse proxy points at 8053.
PERSONACORE_HOST=0.0.0.0
PERSONACORE_PORT=8053

# Docker log rotation. Without these, container logs grow until the disk fills.
DOCKERLOGGING_MAXFILE=3
DOCKERLOGGING_MAXSIZE=10m
