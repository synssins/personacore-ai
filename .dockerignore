# Keep the build context small and, more importantly, keep secrets and state out
# of it. Anything in the context can end up in a layer.

.git
.github
.env
*.env
secrets/
tokens.md

appdata/
*.db
*.sqlite*

tests/
docs/
scripts/

# deploy/ is excluded EXCEPT the entrypoint, which the Dockerfile copies in.
deploy/*
!deploy/entrypoint.py

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
